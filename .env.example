# Keep development safe by default. Copy to .env only for local work.
OSA_ENVIRONMENT=development
OSA_DRY_RUN=true
OSA_ENABLE_FILE_MOVES=false
OSA_EMAIL_PROVIDER=development
OSA_ALLOW_EXTERNAL_LLM=false

# Document locations are registered through the administration workflow.
# Retired OSA_INBOX_ROOT and OSA_COMPANIES_ROOT variables are rejected.
# OSA_DATABASE_URL=postgresql://osa:password@localhost:5432/osa

# Required only when OSA_EMAIL_PROVIDER=smtp. Do not commit real values.
# OSA_SMTP_HOST=
# OSA_SMTP_USERNAME=
# OSA_SMTP_PASSWORD=
