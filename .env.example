# Agent O.S.A. v1 settings, with defaults. Copy to .env only for local work.
# Never commit real values. Retired v0 variables (OSA_DRY_RUN, OSA_ENABLE_FILE_MOVES,
# OSA_EMAIL_PROVIDER, OSA_SMTP_*, OSA_INBOX_ROOT, OSA_COMPANIES_ROOT) are rejected.
OSA_ENVIRONMENT=development
OSA_ENABLE_FILE_EFFECTS=false

# Required in production. Leave unset in development.
# OSA_DATABASE_URL=
# OSA_TELEGRAM_BOT_TOKEN=
# OSA_QUARANTINE_DIR=

# optional: reviewers group
# OSA_TELEGRAM_REVIEWERS_CHAT_ID=

OSA_OLLAMA_BASE_URL=http://127.0.0.1:11434
OSA_OLLAMA_MODEL=gemma3:12b
# OSA_OLLAMA_MODEL_DIGEST=

OSA_EXTERNAL_LLM_ENABLED=false
# Required only when OSA_EXTERNAL_LLM_ENABLED=true.
# OSA_EXTERNAL_LLM_API_KEY=

OSA_POLL_INTERVAL_SECONDS=45
OSA_STABLE_CYCLES=2
OSA_MIN_FILE_AGE_SECONDS=60
OSA_MAX_TEXT_CHARS=12000
OSA_MAX_IMAGE_PAGES=5
OSA_SENSITIVE_EXTENSIONS=.pfx,.p12,.pem,.key,.cer,.crt
OSA_TELEGRAM_SEND_LIMIT_MB=50
